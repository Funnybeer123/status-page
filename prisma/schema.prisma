generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  contributor
  viewer
}

enum RelType {
  parent
  partner
}

enum AssetKind {
  photo
  video
  letter
  audio
}

enum DocKind {
  letter
  note
  story
  clipping
  recipe
  obituary
  will
}

enum NameKind {
  maiden
  nickname
  aka
  birth
}

enum EventKind {
  birth
  death
  marriage
  residence
  immigration
  occupation
  education
  military
  census
  burial
  religion
  reunion
  naturalization
  probate
  other
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  assets       Asset[]      @relation("UploadedBy")
  activities     Activity[]
  comments       Comment[]
  albums         Album[]      @relation("AlbumCreator")
  notifications  Notification[] @relation("Notified")
  noticesSent    Notification[] @relation("Notifier")
  researchTasks  ResearchTask[]
}

model Family {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  people        Person[]
  relationships Relationship[]
  assets        Asset[]
  documents     Document[]
  invites       Invite[]
  places        Place[]
  names         PersonName[]
  residences    Residence[]
  events        LifeEvent[]
  stories       Story[]
  citations     Citation[]
  activities    Activity[]
  albums        Album[]
  comments      Comment[]
  notifications Notification[]
  heirlooms     Heirloom[]
  traditions    Tradition[]
  researchTasks ResearchTask[]
}

model Membership {
  id       String @id @default(cuid())
  userId   String
  familyId String
  role     Role   @default(contributor)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
}

model Invite {
  id        String   @id @default(cuid())
  familyId  String
  token     String   @unique
  email     String?
  role      Role     @default(contributor)
  expiresAt DateTime
  createdAt DateTime @default(now())
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model Person {
  id             String           @id @default(cuid())
  familyId       String
  displayName    String
  givenName      String?
  familyName     String?
  birthDate      DateTime?        @db.Date
  deathDate      DateTime?        @db.Date
  notes          String?
  profileAssetId String?
  sex            String?
  gedcomXref     String?
  family         Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  fromRels       Relationship[]   @relation("FromPerson")
  toRels         Relationship[]   @relation("ToPerson")
  tags           PersonTag[]
  documents      DocumentPerson[]
  names          PersonName[]
  residences     Residence[]
  events         LifeEvent[]      @relation("EventSubject")
  otherEvents    LifeEvent[]      @relation("EventOther")
  storiesTold    Story[]          @relation("StoryTeller")
  storyLinks     StoryPerson[]
  citations      Citation[]
  heirlooms      Heirloom[]
  traditions     Tradition[]
  researchTasks  ResearchTask[]
}

model Relationship {
  id           String   @id @default(cuid())
  familyId     String
  fromPersonId String
  toPersonId   String
  type         RelType
  startedAt    DateTime? @db.Date
  endedAt      DateTime? @db.Date
  family       Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  fromPerson   Person   @relation("FromPerson", fields: [fromPersonId], references: [id], onDelete: Cascade)
  toPerson     Person   @relation("ToPerson", fields: [toPersonId], references: [id], onDelete: Cascade)

  @@index([familyId, type])
}

model Asset {
  id           String      @id @default(cuid())
  familyId     String
  kind         AssetKind
  title        String?
  mimeType     String
  storagePath  String
  capturedAt   DateTime?
  createdAt    DateTime    @default(now())
  uploadedById String
  family       Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  uploadedBy   User        @relation("UploadedBy", fields: [uploadedById], references: [id])
  tags         PersonTag[]
  document     Document?
  citations    Citation[]
  comments     Comment[]
  albumItems   AlbumItem[]
}

model PersonTag {
  id       String @id @default(cuid())
  assetId  String
  personId String
  asset    Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([assetId, personId])
}

model Document {
  id         String           @id @default(cuid())
  familyId   String
  assetId    String?          @unique
  title      String
  kind       DocKind
  transcript String
  writtenAt  DateTime?        @db.Date
  createdAt  DateTime         @default(now())
  family     Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  asset      Asset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)
  people     DocumentPerson[]
  chunks     Chunk[]
  story      Story?
  citations  Citation[]
  comments   Comment[]
  albumItems AlbumItem[]
}

model DocumentPerson {
  documentId String
  personId   String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([documentId, personId])
}

model Chunk {
  id         String                       @id @default(cuid())
  familyId   String
  documentId String
  personId   String?
  content    String
  embedding  Unsupported("vector(1536)")?
  document   Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

model Place {
  id         String      @id @default(cuid())
  familyId   String
  name       String
  locality   String?
  region     String?
  country    String?
  latitude   Float?
  longitude  Float?
  family     Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  residences Residence[]
  events     LifeEvent[]

  @@index([familyId])
}

model PersonName {
  id         String     @id @default(cuid())
  familyId   String
  personId   String
  kind       NameKind
  name       String
  startedAt  DateTime?  @db.Date
  endedAt    DateTime?  @db.Date
  family     Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person     Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  citations  Citation[]

  @@index([familyId, personId])
}

model Residence {
  id         String     @id @default(cuid())
  familyId   String
  personId   String
  placeId    String
  startedAt  DateTime?  @db.Date
  endedAt    DateTime?  @db.Date
  notes      String?
  family     Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person     Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  place      Place      @relation(fields: [placeId], references: [id], onDelete: Cascade)
  citations  Citation[]

  @@index([familyId, personId])
}

model LifeEvent {
  id            String     @id @default(cuid())
  familyId      String
  personId      String
  otherPersonId String?
  placeId       String?
  kind          EventKind
  title         String
  summary       String?
  happenedOn    DateTime?  @db.Date
  family        Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person        Person     @relation("EventSubject", fields: [personId], references: [id], onDelete: Cascade)
  otherPerson   Person?    @relation("EventOther", fields: [otherPersonId], references: [id], onDelete: SetNull)
  place         Place?     @relation(fields: [placeId], references: [id], onDelete: SetNull)
  citations     Citation[]

  @@index([familyId, happenedOn])
}

model Story {
  id             String        @id @default(cuid())
  familyId       String
  title          String
  body           String
  recordedAt     DateTime?     @db.Date
  tellerPersonId String?
  documentId     String?       @unique
  family         Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  teller         Person?       @relation("StoryTeller", fields: [tellerPersonId], references: [id], onDelete: SetNull)
  document       Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  people         StoryPerson[]
  citations      Citation[]
  comments       Comment[]
  albumItems     AlbumItem[]

  @@index([familyId])
}

model StoryPerson {
  storyId  String
  personId String
  story    Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([storyId, personId])
}

model Citation {
  id          String      @id @default(cuid())
  familyId    String
  claim       String
  personId    String?
  eventId     String?
  nameId      String?
  residenceId String?
  storyId     String?
  documentId  String?
  assetId     String?
  pageNote    String?
  family      Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person      Person?     @relation(fields: [personId], references: [id], onDelete: Cascade)
  event       LifeEvent?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        PersonName? @relation(fields: [nameId], references: [id], onDelete: Cascade)
  residence   Residence?  @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  story       Story?      @relation(fields: [storyId], references: [id], onDelete: Cascade)
  document    Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  asset       Asset?      @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([familyId])
}

model Activity {
  id         String   @id @default(cuid())
  familyId   String
  actorId    String
  verb       String
  entityType String
  entityId   String?
  title      String
  summary    String?
  createdAt  DateTime @default(now())
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([familyId, createdAt])
}

model Album {
  id          String      @id @default(cuid())
  familyId    String
  title       String
  summary     String?
  createdAt   DateTime    @default(now())
  createdById String
  family      Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("AlbumCreator", fields: [createdById], references: [id])
  items       AlbumItem[]

  @@index([familyId])
}

model AlbumItem {
  id         String    @id @default(cuid())
  albumId    String
  assetId    String?
  documentId String?
  storyId    String?
  addedAt    DateTime  @default(now())
  album      Album     @relation(fields: [albumId], references: [id], onDelete: Cascade)
  asset      Asset?    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  story      Story?    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([albumId])
}

model Comment {
  id         String    @id @default(cuid())
  familyId   String
  authorId   String
  body       String
  createdAt  DateTime  @default(now())
  assetId    String?
  documentId String?
  storyId    String?
  family     Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  asset      Asset?    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  story      Story?    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([familyId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  familyId  String
  userId    String
  actorId   String
  title     String
  body      String?
  href      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  family    Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User      @relation("Notified", fields: [userId], references: [id], onDelete: Cascade)
  actor     User      @relation("Notifier", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([familyId, createdAt])
}

model Heirloom {
  id         String    @id @default(cuid())
  familyId   String
  personId   String?
  title      String
  summary    String?
  acquiredAt DateTime? @db.Date
  createdAt  DateTime  @default(now())
  family     Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person     Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([familyId])
}

model Tradition {
  id        String   @id @default(cuid())
  familyId  String
  personId  String?
  title     String
  summary   String?
  season    String?
  createdAt DateTime @default(now())
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person    Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([familyId])
}

model ResearchTask {
  id          String    @id @default(cuid())
  familyId    String
  personId    String?
  title       String
  body        String?
  doneAt      DateTime?
  createdAt   DateTime  @default(now())
  createdById String
  family      Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person      Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([familyId, doneAt])
}
