generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  contributor
  viewer
}

enum RelType {
  parent
  partner
}

enum AssetKind {
  photo
  video
  letter
}

enum DocKind {
  letter
  note
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  assets       Asset[]      @relation("UploadedBy")
}

model Family {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  people        Person[]
  relationships Relationship[]
  assets        Asset[]
  documents     Document[]
  invites       Invite[]
}

model Membership {
  id       String @id @default(cuid())
  userId   String
  familyId String
  role     Role   @default(contributor)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
}

model Invite {
  id        String   @id @default(cuid())
  familyId  String
  token     String   @unique
  email     String?
  role      Role     @default(contributor)
  expiresAt DateTime
  createdAt DateTime @default(now())
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model Person {
  id             String           @id @default(cuid())
  familyId       String
  displayName    String
  givenName      String?
  familyName     String?
  birthDate      DateTime?        @db.Date
  deathDate      DateTime?        @db.Date
  notes          String?
  profileAssetId String?
  family         Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  fromRels       Relationship[]   @relation("FromPerson")
  toRels         Relationship[]   @relation("ToPerson")
  tags           PersonTag[]
  documents      DocumentPerson[]
}

model Relationship {
  id           String   @id @default(cuid())
  familyId     String
  fromPersonId String
  toPersonId   String
  type         RelType
  startedAt    DateTime? @db.Date
  endedAt      DateTime? @db.Date
  family       Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  fromPerson   Person   @relation("FromPerson", fields: [fromPersonId], references: [id], onDelete: Cascade)
  toPerson     Person   @relation("ToPerson", fields: [toPersonId], references: [id], onDelete: Cascade)

  @@index([familyId, type])
}

model Asset {
  id           String      @id @default(cuid())
  familyId     String
  kind         AssetKind
  title        String?
  mimeType     String
  storagePath  String
  capturedAt   DateTime?
  createdAt    DateTime    @default(now())
  uploadedById String
  family       Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  uploadedBy   User        @relation("UploadedBy", fields: [uploadedById], references: [id])
  tags         PersonTag[]
  document     Document?
}

model PersonTag {
  id       String @id @default(cuid())
  assetId  String
  personId String
  asset    Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([assetId, personId])
}

model Document {
  id         String           @id @default(cuid())
  familyId   String
  assetId    String?          @unique
  title      String
  kind       DocKind
  transcript String
  writtenAt  DateTime?        @db.Date
  createdAt  DateTime         @default(now())
  family     Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  asset      Asset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)
  people     DocumentPerson[]
  chunks     Chunk[]
}

model DocumentPerson {
  documentId String
  personId   String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([documentId, personId])
}

model Chunk {
  id         String                       @id @default(cuid())
  familyId   String
  documentId String
  personId   String?
  content    String
  embedding  Unsupported("vector(1536)")?
  document   Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([familyId])
}
