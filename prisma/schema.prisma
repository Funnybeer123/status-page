generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  contributor
  viewer
}

enum RelType {
  parent
  partner
  adoptive
  step
}

enum PartnershipEnd {
  divorce
  separation
}

enum ShareKind {
  memorial
  album
}

enum AssetKind {
  photo
  video
  letter
  audio
}

enum DocKind {
  letter
  note
  story
  clipping
  recipe
  obituary
  will
  capsule
}

enum NameKind {
  maiden
  nickname
  aka
  birth
}

enum EventKind {
  birth
  death
  marriage
  residence
  immigration
  occupation
  education
  military
  census
  burial
  religion
  reunion
  naturalization
  probate
  divorce
  separation
  baptism
  other
}

enum DatePrecision {
  exact
  circa
  before
  after
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  assets       Asset[]      @relation("UploadedBy")
  activities     Activity[]
  comments       Comment[]
  albums         Album[]      @relation("AlbumCreator")
  notifications  Notification[] @relation("Notified")
  noticesSent    Notification[] @relation("Notifier")
  researchTasks  ResearchTask[]
  documentRevisions DocumentRevision[]
  shareLinks     ShareLink[]
  promptAnswers  StoryPromptAnswer[]
  personChanges  PersonChange[]
  askConversations AskConversation[]
  savedSearches  SavedSearch[]
  suggestions    FactSuggestion[] @relation("SuggestedBy")
  reviews        FactSuggestion[] @relation("ReviewedBy")
  journals       JournalEntry[]
  bookmarks      PersonBookmark[]
  follows        PersonFollow[]
  shareOpens     ShareLinkOpen[]
  transcripts    Document[]      @relation("TranscriptCredit")
  meetings       FamilyMeeting[]
  visits         PersonVisit[]
}

model Family {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  bannerText    String?
  bannerNote    String?
  calendarToken String?        @unique
  nameStyle     String?
  dateStyle     String?
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  people        Person[]
  relationships Relationship[]
  assets        Asset[]
  documents     Document[]
  invites       Invite[]
  places        Place[]
  names         PersonName[]
  residences    Residence[]
  events        LifeEvent[]
  stories       Story[]
  citations     Citation[]
  activities    Activity[]
  albums        Album[]
  comments      Comment[]
  notifications Notification[]
  heirlooms     Heirloom[]
  traditions    Tradition[]
  researchTasks ResearchTask[]
  storyPrompts  StoryPrompt[]
  shareLinks    ShareLink[]
  eventWitnesses EventWitness[]
  timeCapsules  TimeCapsule[]
  interviewAnswers InterviewAnswer[]
  personChanges PersonChange[]
  branches      FamilyBranch[]
  cemeteries    Cemetery[]
  photoPairs    PhotoPair[]
  voyages       Voyage[]
  schoolings    Schooling[]
  reunions      ReunionGathering[]
  occupations   OccupationRecord[]
  godparents    Godparent[]
  congregations Congregation[]
  landRecords   LandRecord[]
  militaryServices MilitaryService[]
  bibleRecords  BibleRecord[]
  mottos        FamilyMotto[]
  passports     PassportRecord[]
  askConversations AskConversation[]
  custodyRecords CustodyRecord[]
  businesses    FamilyBusiness[]
  awards        AwardRecord[]
  clubs         ClubMembership[]
  probateRecords ProbateRecord[]
  naturalizations NaturalizationRecord[]
  addresses     FamilyAddress[]
  apprenticeships Apprenticeship[]
  mentions      NewspaperMention[]
  pets          FamilyPet[]
  textiles      TextileRecord[]
  dnaNotes      DnaNote[]
  heirloomLoans HeirloomLoan[]
  homes         FamilyHome[]
  digitizeItems DigitizeItem[]
  pinnedMemories PinnedMemory[]
  handwritingSamples HandwritingSample[]
  inscriptions  GravestoneInscription[]
  holidays      FamilyHoliday[]
  reunionDishes ReunionDish[]
  lifeChapters  LifeChapter[]
  filmMoments   FilmMoment[]
  militaryUnits MilitaryUnit[]
  hymns         FamilyHymn[]
  farms         FamilyFarm[]
  censusHouseholds CensusHousehold[]
  churchRegisters ChurchRegister[]
  taxLists      TaxList[]
  savedSearches SavedSearch[]
  photoNotes    PhotoNote[]
  shareConsents ShareConsent[]
  adoptionPapers AdoptionPaper[]
  cityDirectories CityDirectory[]
  militaryPapers MilitaryPaper[]
  schoolClasses SchoolClass[]
  suggestions   FactSuggestion[]
  journals      JournalEntry[]
  meetings      FamilyMeeting[]
  visits        PersonVisit[]
  restores      PhotoRestore[]
}

model Membership {
  id       String  @id @default(cuid())
  userId   String
  familyId String
  role     Role    @default(contributor)
  personId String?
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  family   Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person   Person? @relation("ClaimedBy", fields: [personId], references: [id], onDelete: SetNull)

  @@unique([userId, familyId])
}

model Invite {
  id        String   @id @default(cuid())
  familyId  String
  token     String   @unique
  email     String?
  role      Role     @default(contributor)
  purpose   String   @default("member")
  expiresAt DateTime
  createdAt DateTime @default(now())
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model Person {
  id             String           @id @default(cuid())
  familyId       String
  displayName    String
  givenName      String?
  familyName     String?
  birthDate      DateTime?        @db.Date
  deathDate      DateTime?        @db.Date
  notes          String?
  profileAssetId String?
  sex            String?
  gedcomXref     String?
  causeOfDeath   String?
  languages      String?
  burialPlot     String?
  pronunciation  String?
  ownerNote      String?
  deletedAt      DateTime?
  family         Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  claimedBy      Membership[]     @relation("ClaimedBy")
  fromRels       Relationship[]   @relation("FromPerson")
  toRels         Relationship[]   @relation("ToPerson")
  tags           PersonTag[]
  documents      DocumentPerson[]
  names          PersonName[]
  residences     Residence[]
  events         LifeEvent[]      @relation("EventSubject")
  otherEvents    LifeEvent[]      @relation("EventOther")
  storiesTold    Story[]          @relation("StoryTeller")
  storyLinks     StoryPerson[]
  citations      Citation[]
  heirlooms      Heirloom[]
  traditions     Tradition[]
  researchTasks  ResearchTask[]
  assignedTasks  ResearchTask[] @relation("TaskAssignee")
  assignedDigitize DigitizeItem[] @relation("DigitizeAssignee")
  directoryEntries CityDirectory[]
  militaryPapers MilitaryPaper[]
  classSeats     SchoolClassPupil[]
  suggestions    FactSuggestion[]
  witnessed      EventWitness[]
  capsulesFrom   TimeCapsule[]  @relation("CapsuleFrom")
  capsulesTo     TimeCapsule[]  @relation("CapsuleAddressee")
  interviewAnswers InterviewAnswer[]
  personChanges  PersonChange[]
  branchLinks    FamilyBranchPerson[]
  cemeteryPlots  CemeteryPlot[]
  voyageLinks    VoyagePerson[]
  schoolings     Schooling[]
  reunionGuests  ReunionGuest[]
  occupations    OccupationRecord[]
  godchildren    Godparent[]    @relation("Godchild")
  godparentOf    Godparent[]    @relation("Godparent")
  congregations  Congregation[]
  landRecords    LandRecord[]
  militaryServices MilitaryService[]
  bibleRecords   BibleRecord[]
  passports      PassportRecord[]
  custodyRecords CustodyRecord[]
  businessLinks  FamilyBusinessPerson[]
  awards         AwardRecord[]
  clubs          ClubMembership[]
  probateRecords ProbateRecord[]
  naturalizations NaturalizationRecord[]
  addresses      FamilyAddress[]
  apprenticeships Apprenticeship[]
  mentions       NewspaperMention[]
  pets           FamilyPet[]
  textiles       TextileRecord[]
  dnaNotes       DnaNote[]
  heirloomLoans  HeirloomLoan[]
  homeStays      FamilyHomeResident[]
  digitizeItems  DigitizeItem[]
  handwritingSamples HandwritingSample[]
  inscriptions   GravestoneInscription[]
  guestbook      Comment[]
  potluckDishes  ReunionDish[]
  lifeChapters   LifeChapter[]
  censusRows     CensusHouseholdPerson[]
  registerLines  ChurchRegisterLine[] @relation("RegisterSubject")
  registerOther  ChurchRegisterLine[] @relation("RegisterOther")
  taxNames       TaxListName[]
  shareConsents  ShareConsent[]
  bookmarks      PersonBookmark[]
  follows        PersonFollow[]
  heirloomHolds  HeirloomHold[]
  meetings       FamilyMeetingPerson[]
  visits         PersonVisit[]
}

model Relationship {
  id           String   @id @default(cuid())
  familyId     String
  fromPersonId String
  toPersonId   String
  type         RelType
  startedAt    DateTime?      @db.Date
  endedAt      DateTime?      @db.Date
  endedKind    PartnershipEnd?
  family       Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  fromPerson   Person   @relation("FromPerson", fields: [fromPersonId], references: [id], onDelete: Cascade)
  toPerson     Person   @relation("ToPerson", fields: [toPersonId], references: [id], onDelete: Cascade)
  adoptionPaper AdoptionPaper?

  @@index([familyId, type])
}

model Asset {
  id           String      @id @default(cuid())
  familyId     String
  kind         AssetKind
  title        String?
  mimeType     String
  storagePath  String
  capturedAt   DateTime?
  createdAt    DateTime    @default(now())
  uploadedById String
  deletedAt    DateTime?
  placeId      String?
  family       Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  uploadedBy   User        @relation("UploadedBy", fields: [uploadedById], references: [id])
  place        Place?      @relation(fields: [placeId], references: [id], onDelete: SetNull)
  tags         PersonTag[]
  document     Document?
  citations    Citation[]
  comments     Comment[]
  albumItems   AlbumItem[]
  pairThen     PhotoPair[] @relation("PairThen")
  pairNow      PhotoPair[] @relation("PairNow")
  custody      CustodyRecord[]
  homePhotos   FamilyHomePhoto[]
  reunionPhotos ReunionPhoto[]
  handwritingSamples HandwritingSample[]
  pinnedMemories PinnedMemory[]
  promptAnswers  StoryPromptAnswer[]
  researchTasks  ResearchTask[]
  filmMoments    FilmMoment[]
  photoNotes     PhotoNote[]
  censusScans    CensusHousehold[]
  voyageManifests Voyage[]
  landDeeds      LandRecord[]
  restoreOriginal PhotoRestore[] @relation("RestoreOriginal")
  restoreCleaned  PhotoRestore[] @relation("RestoreCleaned")
}

model PersonTag {
  id       String @id @default(cuid())
  assetId  String
  personId String
  x        Float?
  y        Float?
  asset    Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([assetId, personId])
}

model Document {
  id          String           @id @default(cuid())
  familyId    String
  assetId     String?          @unique
  title       String
  kind        DocKind
  transcript  String
  translation String?
  needsReview Boolean          @default(false)
  replyToId   String?
  writtenAt   DateTime?        @db.Date
  createdAt   DateTime         @default(now())
  deletedAt   DateTime?
  family      Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  asset       Asset?           @relation(fields: [assetId], references: [id], onDelete: SetNull)
  replyTo     Document?        @relation("LetterThread", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Document[]       @relation("LetterThread")
  people      DocumentPerson[]
  chunks      Chunk[]
  story       Story?
  citations   Citation[]
  comments    Comment[]
  albumItems  AlbumItem[]
  revisions   DocumentRevision[]
  timeCapsule TimeCapsule?
  custody     CustodyRecord[]
  handwritingSamples HandwritingSample[]
  pinnedMemories PinnedMemory[]
  potluckDishes ReunionDish[]
  adoptionPapers AdoptionPaper[]
  militaryPapers MilitaryPaper[]
  keepOutOfAsk Boolean          @default(false)
  transcribedById String?
  transcriptLockedAt DateTime?
  transcribedBy User?           @relation("TranscriptCredit", fields: [transcribedById], references: [id], onDelete: SetNull)
}

model DocumentPerson {
  documentId String
  personId   String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([documentId, personId])
}

model Chunk {
  id         String                       @id @default(cuid())
  familyId   String
  documentId String
  personId   String?
  content    String
  embedding  Unsupported("vector(1536)")?
  document   Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

model Place {
  id         String      @id @default(cuid())
  familyId   String
  name       String
  locality   String?
  region     String?
  country    String?
  latitude   Float?
  longitude  Float?
  parentId   String?
  kind       String?
  family     Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  parent     Place?      @relation("PlaceTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Place[]     @relation("PlaceTree")
  residences Residence[]
  events     LifeEvent[]
  homes      FamilyHome[]
  photos     Asset[]

  @@index([familyId])
  @@index([parentId])
}

model PersonName {
  id         String     @id @default(cuid())
  familyId   String
  personId   String
  kind       NameKind
  name       String
  startedAt  DateTime?  @db.Date
  endedAt    DateTime?  @db.Date
  family     Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person     Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  citations  Citation[]

  @@index([familyId, personId])
}

model Residence {
  id         String     @id @default(cuid())
  familyId   String
  personId   String
  placeId    String
  startedAt  DateTime?  @db.Date
  endedAt    DateTime?  @db.Date
  notes      String?
  family     Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person     Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  place      Place      @relation(fields: [placeId], references: [id], onDelete: Cascade)
  citations  Citation[]

  @@index([familyId, personId])
}

model LifeEvent {
  id            String     @id @default(cuid())
  familyId      String
  personId      String
  otherPersonId String?
  placeId       String?
  kind          EventKind
  title         String
  summary       String?
  happenedOn    DateTime?  @db.Date
  rangeEnd      DateTime?  @db.Date
  preferred     Boolean    @default(false)
  precision     DatePrecision @default(exact)
  family        Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person        Person     @relation("EventSubject", fields: [personId], references: [id], onDelete: Cascade)
  otherPerson   Person?    @relation("EventOther", fields: [otherPersonId], references: [id], onDelete: SetNull)
  place         Place?     @relation(fields: [placeId], references: [id], onDelete: SetNull)
  citations     Citation[]
  witnesses     EventWitness[]

  @@index([familyId, happenedOn])
}

model Story {
  id             String        @id @default(cuid())
  familyId       String
  title          String
  body           String
  recordedAt     DateTime?     @db.Date
  tellerPersonId String?
  documentId     String?       @unique
  family         Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  teller         Person?       @relation("StoryTeller", fields: [tellerPersonId], references: [id], onDelete: SetNull)
  document       Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  people         StoryPerson[]
  citations      Citation[]
  comments       Comment[]
  albumItems     AlbumItem[]
  promptAnswers  StoryPromptAnswer[]
  interviewAnswers InterviewAnswer[]
  pinnedMemories PinnedMemory[]
  journals       JournalEntry[]
  keepOutOfAsk   Boolean       @default(false)

  @@index([familyId])
}

model StoryPerson {
  storyId  String
  personId String
  story    Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([storyId, personId])
}

model Citation {
  id          String      @id @default(cuid())
  familyId    String
  claim       String
  personId    String?
  eventId     String?
  nameId      String?
  residenceId String?
  storyId     String?
  documentId  String?
  assetId     String?
  pageNote    String?
  kind        String?
  quality     String?
  family      Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person      Person?     @relation(fields: [personId], references: [id], onDelete: Cascade)
  event       LifeEvent?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        PersonName? @relation(fields: [nameId], references: [id], onDelete: Cascade)
  residence   Residence?  @relation(fields: [residenceId], references: [id], onDelete: Cascade)
  story       Story?      @relation(fields: [storyId], references: [id], onDelete: Cascade)
  document    Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  asset       Asset?      @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([familyId])
}

model Activity {
  id         String   @id @default(cuid())
  familyId   String
  actorId    String
  verb       String
  entityType String
  entityId   String?
  title      String
  summary    String?
  createdAt  DateTime @default(now())
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([familyId, createdAt])
}

model Album {
  id          String      @id @default(cuid())
  familyId    String
  title       String
  summary     String?
  createdAt   DateTime    @default(now())
  createdById String
  family      Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("AlbumCreator", fields: [createdById], references: [id])
  items       AlbumItem[]

  @@index([familyId])
}

model AlbumItem {
  id         String    @id @default(cuid())
  albumId    String
  assetId    String?
  documentId String?
  storyId    String?
  addedAt    DateTime  @default(now())
  album      Album     @relation(fields: [albumId], references: [id], onDelete: Cascade)
  asset      Asset?    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  story      Story?    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([albumId])
}

model Comment {
  id         String    @id @default(cuid())
  familyId   String
  authorId   String
  body       String
  createdAt  DateTime  @default(now())
  assetId    String?
  documentId String?
  storyId    String?
  personId   String?
  family     Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  asset      Asset?    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  story      Story?    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  person     Person?   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([familyId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  familyId  String
  userId    String
  actorId   String
  title     String
  body      String?
  href      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  family    Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User      @relation("Notified", fields: [userId], references: [id], onDelete: Cascade)
  actor     User      @relation("Notifier", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([familyId, createdAt])
}

model Heirloom {
  id         String    @id @default(cuid())
  familyId   String
  personId   String?
  title      String
  summary    String?
  acquiredAt DateTime? @db.Date
  createdAt  DateTime  @default(now())
  family     Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person     Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  loans      HeirloomLoan[]
  holds      HeirloomHold[]

  @@index([familyId])
}

model Tradition {
  id        String   @id @default(cuid())
  familyId  String
  personId  String?
  title     String
  summary   String?
  season    String?
  createdAt DateTime @default(now())
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person    Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([familyId])
}

model ResearchTask {
  id          String    @id @default(cuid())
  familyId    String
  personId    String?
  assigneeId  String?
  title       String
  body        String?
  doneAt      DateTime?
  createdAt   DateTime  @default(now())
  createdById String
  family      Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person      Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  assignee    Person?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  assetId     String?
  asset       Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([familyId, doneAt])
  @@index([assigneeId])
}

model StoryPrompt {
  id        String              @id @default(cuid())
  familyId  String
  title     String
  body      String?
  createdAt DateTime            @default(now())
  family    Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  answers   StoryPromptAnswer[]

  @@index([familyId])
}

model StoryPromptAnswer {
  id        String      @id @default(cuid())
  promptId  String
  storyId   String
  authorId  String
  assetId   String?
  createdAt DateTime    @default(now())
  prompt    StoryPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  story     Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  asset     Asset?      @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([promptId])
}

model ShareLink {
  id          String    @id @default(cuid())
  familyId    String
  token       String    @unique
  kind        ShareKind
  entityId    String
  createdAt   DateTime  @default(now())
  createdById String
  family      Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  revokedAt   DateTime?
  opens       ShareLinkOpen[]

  @@index([familyId, kind])
}

model DocumentRevision {
  id         String   @id @default(cuid())
  documentId String
  transcript String
  editedAt   DateTime @default(now())
  editedById String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  editedBy   User     @relation(fields: [editedById], references: [id], onDelete: Cascade)

  @@index([documentId, editedAt])
}

model EventWitness {
  id       String    @id @default(cuid())
  familyId String
  eventId  String
  personId String
  role     String
  family   Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  event    LifeEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person   Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([eventId, personId])
  @@index([familyId])
}

model TimeCapsule {
  id                String    @id @default(cuid())
  familyId          String
  documentId        String    @unique
  addresseeName     String
  addresseePersonId String?
  fromPersonId      String?
  openOn            DateTime  @db.Date
  createdAt         DateTime  @default(now())
  family            Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  document          Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  addressee         Person?   @relation("CapsuleAddressee", fields: [addresseePersonId], references: [id], onDelete: SetNull)
  fromPerson        Person?   @relation("CapsuleFrom", fields: [fromPersonId], references: [id], onDelete: SetNull)

  @@index([familyId, openOn])
}

model InterviewAnswer {
  id        String   @id @default(cuid())
  familyId  String
  personId  String
  promptKey String
  question  String
  storyId   String
