  createdAt DateTime @default(now())
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId, userId])
}

model PhotoNote {
  id        String   @id @default(cuid())
  familyId  String
  assetId   String
  text      String
  x         Float?
  y         Float?
  createdAt DateTime @default(now())
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([familyId, assetId])
}

model ShareConsent {
  id        String    @id @default(cuid())
  familyId  String
  personId  String
  granted   Boolean   @default(false)
  grantedOn DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  family    Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([familyId, personId])
  @@index([familyId])
}

model AdoptionPaper {
  id             String       @id @default(cuid())
  familyId       String
  relationshipId String       @unique
  documentId     String?
  grantedOn      DateTime?    @db.Date
  notes          String?
  createdAt      DateTime     @default(now())
  family         Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  document       Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([familyId])
}

model CityDirectory {
  id         String   @id @default(cuid())
  familyId   String
  personId   String?
  name       String
  occupation String?
  address    String
  year       Int
  notes      String?
  createdAt  DateTime @default(now())
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person     Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([familyId, year])
}

model MilitaryPaper {
  id         String           @id @default(cuid())
  familyId   String
  personId   String
  serviceId  String?
  documentId String?
  kind       String
  year       Int?
  numberNote String?
  notes      String?
  createdAt  DateTime         @default(now())
  family     Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  person     Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  service    MilitaryService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  document   Document?        @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([familyId, personId])
}

model SchoolClass {
  id        String             @id @default(cuid())
  familyId  String
  school    String
  year      Int
  place     String?
  notes     String?
  createdAt DateTime           @default(now())
  family    Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  pupils    SchoolClassPupil[]

  @@index([familyId, year])
}

model SchoolClassPupil {
  classId  String
  personId String
  class    SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  person   Person      @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([classId, personId])
}

model FactSuggestion {
  id            String    @id @default(cuid())
  familyId      String
  createdById   String
  personId      String?
  entityType    String
  entityId      String?
  field         String
  currentValue  String?
  proposedValue String
  note          String?
  status        String    @default("pending")
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  family        Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy     User      @relation("SuggestedBy", fields: [createdById], references: [id], onDelete: Cascade)
  reviewedBy    User?     @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  person        Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([familyId, status])
}

model JournalEntry {
  id          String    @id @default(cuid())
  familyId    String
  authorId    String
  title       String
  body        String
  recordedAt  DateTime? @db.Date
  storyId     String?   @unique
  createdAt   DateTime  @default(now())
  family      Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  story       Story?    @relation(fields: [storyId], references: [id], onDelete: SetNull)
  keepOutOfAsk Boolean  @default(false)

  @@index([familyId, authorId])
}

model PersonBookmark {
  userId    String
  personId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([userId, personId])
  @@index([personId])
}

model PersonFollow {
  userId    String
  personId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  mutedAt   DateTime?

  @@id([userId, personId])
  @@index([personId])
}

model ShareLinkOpen {
  id          String    @id @default(cuid())
  shareLinkId String
  openedAt    DateTime  @default(now())
  userAgent   String?
  userId      String?
  shareLink   ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([shareLinkId, openedAt])
}

model HeirloomHold {
  id         String    @id @default(cuid())
  heirloomId String
  personId   String
  heldFrom   DateTime? @db.Date
  heldUntil  DateTime? @db.Date
  note       String?
  createdAt  DateTime  @default(now())
  heirloom   Heirloom  @relation(fields: [heirloomId], references: [id], onDelete: Cascade)
  person     Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([heirloomId, heldFrom])
}

model FamilyMeeting {
  id          String    @id @default(cuid())
  familyId    String
  title       String
  happenedOn  DateTime? @db.Date
  notes       String
  createdById String
  createdAt   DateTime  @default(now())
  family      Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  attendees   FamilyMeetingPerson[]

  @@index([familyId, happenedOn])
}

model FamilyMeetingPerson {
  meetingId String
  personId  String
  meeting   FamilyMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  person    Person        @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([meetingId, personId])
}

model PersonVisit {
  userId   String
  personId String
  familyId String
  openedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  person   Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  family   Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@id([userId, personId])
  @@index([userId, openedAt])
  @@index([familyId])
}

model PhotoRestore {
  id         String   @id @default(cuid())
  familyId   String
  title      String
  originalId String
  cleanedId  String
  notes      String?
  createdAt  DateTime @default(now())
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  original   Asset    @relation("RestoreOriginal", fields: [originalId], references: [id], onDelete: Cascade)
  cleaned    Asset    @relation("RestoreCleaned", fields: [cleanedId], references: [id], onDelete: Cascade)

  @@index([familyId])
}
