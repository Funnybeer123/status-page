@using EvanBeer.Resume.Models
@{
    var resume = ViewData["Resume"] as ResumeDocument;
    var pageTitle = ViewData["Title"] as string ?? resume?.Name ?? "Evan Beer";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>@pageTitle</title>
    <meta name="description" content="Resume site for Evan Beer. Confirmed roles at UBT and KBR; remaining history is incomplete pending the source resume." />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    @RenderBody()
</body>
</html>
