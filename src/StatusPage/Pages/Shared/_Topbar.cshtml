@model StatusPage.Domain.StatusPageInfo
@{
    var mark = string.IsNullOrWhiteSpace(Model.Name) ? "B" : Model.Name.Trim()[0].ToString().ToUpperInvariant();
    var onHero = ViewData["TopbarOnHero"] as bool? == true;
}
<header class="topbar@(onHero ? " topbar-hero" : "")">
    <a class="brand" href="/">
        @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
        {
            <img class="brand-logo" src="@Model.LogoUrl" alt="" />
        }
        else
        {
            <span class="mark" aria-hidden="true">@mark</span>
        }
        <span class="wordmark">@Model.Name</span>
    </a>
    <nav>
        <a href="/">Overview</a>
        <a href="/#incidents">Incidents</a>
        <a href="/#report">Report a problem</a>
    </nav>
</header>
