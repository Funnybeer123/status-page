{
  "name": "family-lineage",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:unit": "tsx --test tests/*-unit.test.ts",
    "test:ui": "tsx tests/ui-member-flow.ts && tsx tests/ui-archive-layer.ts && tsx tests/ui-timeline-history.ts && tsx tests/ui-next-layer.ts",
    "test:ui:archive": "tsx tests/ui-archive-layer.ts",
    "test:ui:history": "tsx tests/ui-timeline-history.ts",
    "test:ui:next": "tsx tests/ui-next-layer.ts",
    "test:ui:keep": "tsx tests/ui-keep-shipping.ts",
    "test:ui:this": "tsx tests/ui-this-layer.ts",
    "test:ui:capsule": "tsx tests/ui-capsule-layer.ts",
    "test:ui:ask": "tsx tests/ui-ask-layer.ts",
    "test:ui:print": "tsx tests/ui-print-layer.ts",
    "test:ui:quiz": "tsx tests/ui-quiz-layer.ts",
    "test:ui:packet": "tsx tests/ui-packet-layer.ts",
    "test:ui:chapters": "tsx tests/ui-chapters-layer.ts",
    "test:ui:path": "tsx tests/ui-path-layer.ts",
    "test:ui:places": "tsx tests/ui-places-layer.ts",
    "test:ui:year": "tsx tests/ui-year-layer.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "exifr": "^7.1.3",
    "next": "^15.5.4",
    "next-auth": "5.0.0-beta.29",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prisma": "^6.16.2",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
